# Add these as private Environment Variables in Render.
# Never put real API keys in index.html or commit them to GitHub.
PORT=3000
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Piston-compatible execution API; code runs on this external service, not this Node server.
PISTON_API_URL=https://emkc.org/api/v2/piston
